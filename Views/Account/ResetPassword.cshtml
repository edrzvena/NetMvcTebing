@model Tebing.DTOs.Auth.ResetPasswordDto

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Bikin password baru</h1>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input asp-for="Token" type="hidden"/>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-help"/>
                <div id="password-help" class="form-text">Minimal 6 karakter.</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Simpan Password</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
