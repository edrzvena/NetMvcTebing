@{
    ViewData["Title"] = "Cek Email";
    Layout = "_AuthLayout";
}

<div class="card">
    <div class="card-body p-4">
        <h1 class="h2 mb-2">Cek email kamu</h1>
        <p class="mb-0">Kalau email itu terdaftar, link buat reset password udah dikirim.</p>

        @if (ViewBag.ResetToken is string token)
        {
            @* Belum ada layanan email di MVP — link ditampilkan langsung, cuma buat development/testing. *@
            <div class="alert alert-warning small mt-3 mb-0">
                <p class="fw-semibold mb-1">Mode development: link reset ditampilkan di sini.</p>
                <p class="mb-0">Belum ada pengiriman email, jadi pakai link ini buat lanjut:
                    <a asp-action="ResetPassword" asp-route-token="@token" class="alert-link">Reset password</a>
                </p>
            </div>
        }
    </div>
</div>
<p class="text-center mt-3"><a asp-action="Login">&larr; Kembali ke halaman masuk</a></p>
