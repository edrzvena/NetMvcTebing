@{
    ViewData["Title"] = "Cek Email";
}

<h1>Cek Email</h1>

@if (ViewBag.ResetToken is string token)
{
    <p>
        Belum ada layanan email di MVP ini, jadi link reset ditampilkan langsung di sini
        (khusus development/testing):
    </p>
    <p>
        <a asp-action="ResetPassword" asp-route-token="@token">Klik di sini untuk reset password</a>
    </p>
}
else
{
    <p>Kalau email terdaftar, instruksi reset password akan dikirimkan.</p>
}
