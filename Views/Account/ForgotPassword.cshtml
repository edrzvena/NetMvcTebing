@model Tebing.DTOs.Auth.ForgotPasswordDto

@{
    ViewData["Title"] = "Lupa Password";
    Layout = "_AuthLayout";
}

<div class="card">
    <div class="card-body p-4">
        <h1 class="h2 mb-2">Lupa password</h1>
        <p class="text-secondary mb-3">Masukin email akun kamu, nanti kami kirim link buat bikin password baru.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Kirim Link Reset</button>
        </form>
    </div>
</div>
<p class="text-center mt-3"><a asp-action="Login">&larr; Kembali ke halaman masuk</a></p>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
