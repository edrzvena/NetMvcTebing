@model int

@{
    var (title, message) = Model switch
    {
        404 => ("Halaman gak ditemukan", "Halaman yang kamu cari gak ada, atau udah dipindah."),
        403 => ("Akses ditolak", "Akun kamu gak punya izin buat buka halaman ini."),
        _ => ("Terjadi kesalahan", "Permintaan kamu gak bisa diproses. Coba lagi beberapa saat lagi.")
    };
    ViewData["Title"] = title;
}

<div class="form-narrow mx-auto mt-4">
    <partial name="_EmptyState" model="@(new EmptyStateViewModel(title, message, "Kembali ke Beranda", Url.Action("Index", "Home")))"/>
</div>
