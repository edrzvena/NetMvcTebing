@model List<Tebing.DTOs.Booking.BookingListDto>

@{
    ViewData["Title"] = "Booking Saya";
}

<h1>Booking Saya</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!Model.Any())
{
    <p>Belum ada booking. <a asp-controller="Mountain" asp-action="Index">Cari gunung</a> dulu, yuk.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Gunung</th>
            <th>Jalur</th>
            <th>Tanggal Naik</th>
            <th>Jumlah Orang</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.MountainName</td>
                <td>@booking.RouteName</td>
                <td>@booking.ClimbDate.ToString("dd MMM yyyy")</td>
                <td>@booking.NumberOfPeople</td>
                <td>Rp @booking.TotalPrice.ToString("N0")</td>
                <td>@booking.Status</td>
                <td><a asp-action="Detail" asp-route-id="@booking.Id">Detail</a></td>
            </tr>
        }
        </tbody>
    </table>
}
