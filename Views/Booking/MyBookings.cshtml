@model List<Tebing.DTOs.Booking.BookingListDto>

@{
    ViewData["Title"] = "Booking Saya";
}

<div class="page-header">
    <h1 class="mb-0">Booking Saya</h1>
</div>

@if (!Model.Any())
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel("Belum ada booking",
        "Cari gunung dulu, terus booking dari halaman detail gunungnya.",
        "Lihat Daftar Gunung", Url.Action("Index", "Mountain")))"/>
}
else
{
    @* Desktop: tabel, seluruh baris bisa diklik. *@
    <div class="card d-none d-md-block">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>Gunung</th>
                    <th>Jalur</th>
                    <th>Tanggal naik</th>
                    <th class="text-end">Orang</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th>Pembayaran</th>
                    <th><span class="visually-hidden">Detail</span></th>
                </tr>
                </thead>
                <tbody class="tabular-nums">
                @foreach (var booking in Model)
                {
                    <tr class="table-row-link">
                        <td class="fw-semibold">
                            <a asp-action="Detail" asp-route-id="@booking.Id" class="stretched-link text-reset text-decoration-none">@booking.MountainName</a>
                        </td>
                        <td>@booking.RouteName</td>
                        <td class="text-nowrap">@booking.ClimbDate.ToDisplayDate()</td>
                        <td class="text-end">@booking.NumberOfPeople</td>
                        <td class="text-end text-nowrap">@(booking.TotalPrice <= 0 ? "Gratis" : booking.TotalPrice.ToRupiah())</td>
                        <td>@booking.Status.ToBadge()</td>
                        <td>@booking.PaymentStatus.ToPaymentBadge(booking.TotalPrice)</td>
                        <td class="text-end text-secondary" aria-hidden="true">&rarr;</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @* Mobile: list card kecil. *@
    <div class="d-md-none d-flex flex-column gap-2">
        @foreach (var booking in Model)
        {
            <div class="card card-clickable booking-card">
                <div class="card-body p-3 d-flex gap-3">
                    <partial name="_MountainThumb" model="@(new MountainThumbViewModel(booking.MountainImagePath, booking.MountainName, ThumbSize.Small))"/>
                    <div class="flex-grow-1 min-w-0">
                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="Detail" asp-route-id="@booking.Id" class="stretched-link fw-semibold text-reset text-decoration-none">@booking.MountainName</a>
                        <span class="tabular-nums text-nowrap">@(booking.TotalPrice <= 0 ? "Gratis" : booking.TotalPrice.ToRupiah())</span>
                    </div>
                    <p class="small text-secondary mb-2 tabular-nums">
                        @booking.RouteName &middot; @booking.ClimbDate.ToDisplayDate() &middot; @booking.NumberOfPeople orang
                    </p>
                    <div class="d-flex flex-wrap gap-1">
                        @booking.Status.ToBadge()
                        @booking.PaymentStatus.ToPaymentBadge(booking.TotalPrice)
                    </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
