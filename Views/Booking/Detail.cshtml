@using Tebing.Common.Enums
@using System.Security.Claims
@model Tebing.DTOs.Booking.BookingDetailDto

@{
    ViewData["Title"] = $"Booking #{Model.Id}";
    var isOwner = User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId.ToString();
    var isAdmin = User.IsInRole("Admin");
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h1>Booking #@Model.Id</h1>

<dl class="row">
    <dt class="col-sm-3">Gunung</dt>
    <dd class="col-sm-9">
        <a asp-controller="Mountain" asp-action="Detail" asp-route-id="@Model.MountainId">@Model.MountainName</a>
    </dd>
    <dt class="col-sm-3">Jalur</dt>
    <dd class="col-sm-9">@Model.RouteName</dd>
    <dt class="col-sm-3">Tanggal Naik</dt>
    <dd class="col-sm-9">@Model.ClimbDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Jumlah Orang</dt>
    <dd class="col-sm-9">@Model.NumberOfPeople</dd>
    <dt class="col-sm-3">Total Harga</dt>
    <dd class="col-sm-9">Rp @Model.TotalPrice.ToString("N0")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    @if (Model.Status == BookingStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <dt class="col-sm-3">Alasan Ditolak</dt>
        <dd class="col-sm-9">@Model.RejectionReason</dd>
    }
    @if (isAdmin)
    {
        <dt class="col-sm-3">Dipesan oleh</dt>
        <dd class="col-sm-9">@Model.UserFullName (@Model.UserEmail)</dd>
    }
    <dt class="col-sm-3">Dibuat</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
</dl>

<h3>Peserta Rombongan</h3>
<table class="table table-striped">
    <thead>
    <tr>
        <th>#</th>
        <th>Nama</th>
        <th>NIK</th>
        <th>No. HP</th>
        <th>Kontak Darurat</th>
    </tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Participants.Count; i++)
    {
        var participant = Model.Participants[i];
        <tr>
            <td>@(i + 1)</td>
            <td>@participant.FullName</td>
            <td>@participant.NIK</td>
            <td>@participant.PhoneNumber</td>
            <td>@participant.EmergencyContactName (@participant.EmergencyContactPhone)</td>
        </tr>
    }
    </tbody>
</table>

<h3>Pembayaran</h3>
@if (Model.TotalPrice <= 0)
{
    <p>Booking ini gratis, gak perlu upload bukti transfer.</p>
}
else
{
    @if (Model.Payment is null)
    {
        <p>Belum ada bukti transfer.</p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-3">Status Pembayaran</dt>
            <dd class="col-sm-9">@Model.Payment.Status</dd>
            <dt class="col-sm-3">Jumlah</dt>
            <dd class="col-sm-9">Rp @Model.Payment.Amount.ToString("N0")</dd>
            <dt class="col-sm-3">Diupload</dt>
            <dd class="col-sm-9">@Model.Payment.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            @if (Model.Payment.VerifiedAt is { } verifiedAt)
            {
                <dt class="col-sm-3">Diverifikasi</dt>
                <dd class="col-sm-9">@verifiedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
            }
            @if (Model.Payment.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(Model.Payment.RejectionReason))
            {
                <dt class="col-sm-3">Alasan Ditolak</dt>
                <dd class="col-sm-9">@Model.Payment.RejectionReason</dd>
            }
            <dt class="col-sm-3">Bukti Transfer</dt>
            <dd class="col-sm-9">
                <a asp-controller="Payment" asp-action="Proof" asp-route-bookingId="@Model.Id" target="_blank">Lihat file</a>
            </dd>
        </dl>
    }

    @* Aturan lengkapnya dicek ulang di PaymentService; ini cuma biar form-nya gak muncul kalau udah pasti ditolak. *@
    @if (isOwner && Model.Status == BookingStatus.Pending && Model.Payment?.Status != PaymentStatus.Verified)
    {
        <form asp-controller="Payment" asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-3">
            <input type="hidden" name="BookingId" value="@Model.Id"/>
            <label for="ProofFile" class="form-label">
                @(Model.Payment is null ? "Upload bukti transfer" : "Upload ulang bukti transfer")
                (Rp @Model.TotalPrice.ToString("N0") — JPG, PNG, atau PDF, maks. 2 MB)
            </label>
            <div class="input-group" style="max-width:500px">
                <input type="file" id="ProofFile" name="ProofFile" accept=".jpg,.jpeg,.png,.pdf" class="form-control" required/>
                <button type="submit" class="btn btn-primary">Upload</button>
            </div>
        </form>
    }

    @if (isAdmin && Model.Payment?.Status == PaymentStatus.Pending)
    {
        <div class="d-flex flex-wrap gap-2 align-items-start mb-3">
            <form asp-controller="Payment" asp-action="Verify" method="post"
                  onsubmit="return confirm('Verifikasi pembayaran ini? Booking otomatis jadi Approved.');">
                <input type="hidden" name="BookingId" value="@Model.Id"/>
                <input type="hidden" name="Status" value="@PaymentStatus.Verified"/>
                <button type="submit" class="btn btn-success">Verifikasi Pembayaran</button>
            </form>
            <form asp-controller="Payment" asp-action="Verify" method="post"
                  onsubmit="return confirm('Tolak bukti pembayaran ini?');">
                <input type="hidden" name="BookingId" value="@Model.Id"/>
                <input type="hidden" name="Status" value="@PaymentStatus.Rejected"/>
                <div class="input-group">
                    <input type="text" name="RejectionReason" maxlength="500" class="form-control"
                           placeholder="Alasan ditolak (opsional)"/>
                    <button type="submit" class="btn btn-outline-danger">Tolak Pembayaran</button>
                </div>
            </form>
        </div>
    }
}

@if (Model.Review is { } review)
{
    <h3>Ulasan</h3>
    <p class="mb-1">
        <span class="text-warning">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
        <small class="text-muted ms-2">@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
    </p>
    @if (!string.IsNullOrEmpty(review.Comment))
    {
        <p>@review.Comment</p>
    }
}
else if (isOwner && Model.Status == BookingStatus.Completed)
{
    <h3>Kasih Ulasan</h3>
    <form asp-controller="Review" asp-action="Create" method="post" class="mb-3" style="max-width:600px">
        <input type="hidden" name="BookingId" value="@Model.Id"/>
        <div class="mb-2">
            <label for="Rating" class="form-label">Rating</label>
            <select id="Rating" name="Rating" class="form-select" required>
                <option value="">-- Pilih rating --</option>
                @for (var star = 5; star >= 1; star--)
                {
                    <option value="@star">@(new string('★', star)) (@star)</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label for="Comment" class="form-label">Komentar (opsional)</label>
            <textarea id="Comment" name="Comment" maxlength="1000" rows="3" class="form-control"
                      placeholder="Gimana jalurnya, basecamp-nya, pemandangannya?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Kirim Ulasan</button>
    </form>
}

@if (isOwner && Model.Status == BookingStatus.Pending)
{
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-3"
          onsubmit="return confirm('Batalkan booking ini?');">
        <button type="submit" class="btn btn-outline-danger">Batalkan Booking</button>
    </form>
}

@if (isAdmin && Model.AllowedNextStatuses.Any())
{
    <h3>Aksi Admin</h3>
    <div class="d-flex flex-wrap gap-2 align-items-start mb-3">
        @foreach (var nextStatus in Model.AllowedNextStatuses)
        {
            <form asp-action="UpdateStatus" method="post"
                  onsubmit="return confirm('Ubah status booking jadi @nextStatus?');">
                <input type="hidden" name="BookingId" value="@Model.Id"/>
                <input type="hidden" name="Status" value="@nextStatus"/>
                @if (nextStatus == BookingStatus.Rejected)
                {
                    <div class="input-group">
                        <input type="text" name="RejectionReason" maxlength="500" class="form-control"
                               placeholder="Alasan ditolak (opsional)"/>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                }
                else
                {
                    <button type="submit" class="btn @(nextStatus == BookingStatus.Cancelled ? "btn-outline-danger" : "btn-success")">
                        @(nextStatus switch
                        {
                            BookingStatus.Approved => "Approve",
                            BookingStatus.Completed => "Tandai Selesai",
                            BookingStatus.Cancelled => "Batalkan",
                            _ => nextStatus.ToString()
                        })
                    </button>
                }
            </form>
        }
    </div>
}

@if (isAdmin)
{
    <a asp-action="Manage">&larr; Kembali ke kelola booking</a>
}
else
{
    <a asp-action="MyBookings">&larr; Kembali ke booking saya</a>
}
