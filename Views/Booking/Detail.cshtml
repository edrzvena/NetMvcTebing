@using System.Security.Claims
@model Tebing.DTOs.Booking.BookingDetailDto

@{
    ViewData["Title"] = $"Booking #{Model.Id}";
    var isOwner = User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId.ToString();
    var isAdmin = User.IsInRole("Admin");
    var payment = Model.Payment;
    var requiresPayment = Model.TotalPrice > 0;
    var isEnded = Model.Status is BookingStatus.Rejected or BookingStatus.Cancelled;
    var isApprovedOrDone = Model.Status is BookingStatus.Approved or BookingStatus.Completed;

    var steps = new (string Label, bool Done)[]
    {
        ("Dibuat", true),
        (requiresPayment ? "Pembayaran diverifikasi" : "Pembayaran (gratis)",
            !requiresPayment || payment?.Status == PaymentStatus.Verified || isApprovedOrDone),
        ("Disetujui", isApprovedOrDone),
        ("Selesai", Model.Status == BookingStatus.Completed)
    };

    // Aturan lengkapnya dicek ulang di PaymentService; ini cuma biar form-nya gak muncul kalau udah pasti ditolak.
    var canUpload = isOwner && requiresPayment && Model.Status == BookingStatus.Pending &&
                    payment?.Status != PaymentStatus.Verified;
    var canReview = isOwner && Model.Status == BookingStatus.Completed && Model.Review is null;
}

@{
    async Task UploadForm(string buttonText, string buttonClass)
    {
        <form asp-controller="Payment" asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-3">
            <input type="hidden" name="BookingId" value="@Model.Id"/>
            <label for="ProofFile" class="form-label">Bukti transfer <span class="text-secondary">(JPG, PNG, atau PDF, maks. 2 MB)</span></label>
            <div class="d-flex flex-wrap gap-2">
                <input type="file" id="ProofFile" name="ProofFile" accept=".jpg,.jpeg,.png,.pdf"
                       class="form-control w-auto flex-grow-1" required/>
                <button type="submit" class="btn @buttonClass">@buttonText</button>
            </div>
        </form>
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small mb-2">
        @if (isAdmin && !isOwner)
        {
            <li class="breadcrumb-item"><a asp-action="Manage">Kelola Booking</a></li>
        }
        else
        {
            <li class="breadcrumb-item"><a asp-action="MyBookings">Booking Saya</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">#@Model.Id</li>
    </ol>
</nav>

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <partial name="_MountainThumb" model="@(new MountainThumbViewModel(Model.MountainImagePath, Model.MountainName, ThumbSize.Medium))"/>
        <div>
        <h1 class="mb-1">Booking #@Model.Id</h1>
        <p class="text-secondary mb-0">
            <a asp-controller="Mountain" asp-action="Detail" asp-route-id="@Model.MountainId">@Model.MountainName</a>
            &middot; @Model.RouteName &middot; <span class="tabular-nums">@Model.ClimbDate.ToDisplayDate()</span>
        </p>
        </div>
    </div>
    <div class="fs-5">@Model.Status.ToBadge()</div>
</div>

<div class="row g-4">
    <div class="@(isAdmin ? "col-lg-8" : "col-lg-9 col-xl-8")">

        @* ---------- Status: stepper, atau alert kalau booking berhenti ---------- *@
        @if (Model.Status == BookingStatus.Rejected)
        {
            <div class="alert alert-danger" role="status">
                <p class="fw-semibold mb-1">Booking ditolak admin.</p>
                <p class="mb-0">
                    @(string.IsNullOrEmpty(Model.RejectionReason) ? "Gak ada alasan yang dicantumkan." : $"Alasan: {Model.RejectionReason}")
                    Kamu bisa bikin booking baru dari halaman gunungnya.
                </p>
            </div>
        }
        else if (Model.Status == BookingStatus.Cancelled)
        {
            <div class="alert alert-secondary" role="status">
                <p class="fw-semibold mb-1">Booking dibatalkan.</p>
                <p class="mb-0">Booking ini udah gak aktif. Kalau masih mau naik, bikin booking baru dari halaman gunungnya.</p>
            </div>
        }
        else
        {
            @* Langkah pertama yang belum selesai = yang lagi jalan (ring amber). *@
            var currentStep = Array.FindIndex(steps, s => !s.Done);
            <ol class="stepper mb-4" aria-label="Progres booking">
                @for (var i = 0; i < steps.Length; i++)
                {
                    var step = steps[i];
                    <li class="stepper-item @(step.Done ? "done" : "") @(i == currentStep ? "current" : "")"
                        aria-current="@(i == currentStep ? "step" : null)">
                        <div class="stepper-track">
                            <span class="stepper-dot" aria-hidden="true"></span>
                            <span class="stepper-line" aria-hidden="true"></span>
                        </div>
                        <span>@step.Label<span class="visually-hidden">@(step.Done ? " (selesai)" : " (belum)")</span></span>
                    </li>
                }
            </ol>
        }

        @* ---------- Langkah berikutnya (khusus pemilik booking) ---------- *@
        @if (isOwner && !isEnded && !(Model.Status == BookingStatus.Completed && Model.Review is not null))
        {
            <section class="card card-highlight mb-4" aria-labelledby="next-step-title">
                <div class="card-body p-3 p-lg-4">
                    <h2 id="next-step-title" class="mb-2">Langkah berikutnya</h2>
                    @if (Model.Status == BookingStatus.Pending && requiresPayment)
                    {
                        if (payment is null)
                        {
                            <p class="mb-0">Transfer <span class="fw-semibold tabular-nums">@Model.TotalPrice.ToRupiah()</span>, terus upload buktinya biar admin bisa verifikasi.</p>
                            await UploadForm("Upload Bukti", "btn-primary");
                        }
                        else if (payment.Status == PaymentStatus.Rejected)
                        {
                            <p class="mb-0">
                                Bukti transfer ditolak@(string.IsNullOrEmpty(payment.RejectionReason) ? "." : $": {payment.RejectionReason}.")
                                Upload ulang bukti transfer <span class="fw-semibold tabular-nums">@Model.TotalPrice.ToRupiah()</span> yang benar.
                            </p>
                            await UploadForm("Upload Ulang Bukti", "btn-primary");
                        }
                        else if (payment.Status == PaymentStatus.Pending)
                        {
                            <p class="mb-0">Bukti transfer lagi dicek admin. Kalau tadi salah file, kamu masih bisa ganti.</p>
                            await UploadForm("Ganti Bukti", "btn-outline-secondary");
                        }
                        else
                        {
                            <p class="mb-0">Pembayaran udah terverifikasi, tinggal tunggu admin menyetujui booking.</p>
                        }
                    }
                    else if (Model.Status == BookingStatus.Pending)
                    {
                        <p class="mb-0">Booking ini gratis, tinggal tunggu admin menyetujui.</p>
                    }
                    else if (Model.Status == BookingStatus.Approved)
                    {
                        <p class="mb-0">Booking disetujui. Sampai ketemu di @Model.RouteName tanggal <span class="tabular-nums">@Model.ClimbDate.ToDisplayDate()</span>.</p>
                    }
                    else if (canReview)
                    {
                        <p class="mb-3">Pendakian selesai. Kasih ulasan biar pendaki lain kebantu.</p>
                        <form asp-controller="Review" asp-action="Create" method="post" class="form-narrow">
                            <input type="hidden" name="BookingId" value="@Model.Id"/>
                            <div class="mb-3">
                                <label for="Rating" class="form-label">Rating</label>
                                <select id="Rating" name="Rating" class="form-select w-auto" required>
                                    <option value="">Pilih rating</option>
                                    @for (var star = 5; star >= 1; star--)
                                    {
                                        <option value="@star">@star dari 5</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="Comment" class="form-label">Komentar <span class="text-secondary">(opsional)</span></label>
                                <textarea id="Comment" name="Comment" maxlength="1000" rows="3" class="form-control"
                                          aria-describedby="comment-help"></textarea>
                                <div id="comment-help" class="form-text">Gimana jalurnya, basecamp-nya, pemandangannya? Maks. 1000 karakter.</div>
                            </div>
                            <button type="submit" class="btn btn-primary">Kirim Ulasan</button>
                        </form>
                    }
                </div>
            </section>
        }

        @* ---------- Detail ---------- *@
        <div class="card">
            <section class="section p-3 p-lg-4">
                <h2 class="mb-3">Ringkasan</h2>
                <dl class="row mb-0 tabular-nums">
                    <dt class="col-sm-4 fw-normal text-secondary">Gunung</dt>
                    <dd class="col-sm-8">@Model.MountainName</dd>
                    <dt class="col-sm-4 fw-normal text-secondary">Jalur</dt>
                    <dd class="col-sm-8">@Model.RouteName</dd>
                    <dt class="col-sm-4 fw-normal text-secondary">Tanggal naik</dt>
                    <dd class="col-sm-8">@Model.ClimbDate.ToDisplayDate()</dd>
                    <dt class="col-sm-4 fw-normal text-secondary">Jumlah orang</dt>
                    <dd class="col-sm-8">@Model.NumberOfPeople</dd>
                    <dt class="col-sm-4 fw-normal text-secondary">Total</dt>
                    <dd class="col-sm-8 fw-semibold">@(requiresPayment ? Model.TotalPrice.ToRupiah() : "Gratis")</dd>
                    <dt class="col-sm-4 fw-normal text-secondary">Dibuat</dt>
                    <dd class="col-sm-8 mb-0">@Model.CreatedAt.ToDisplayDateTime()</dd>
                </dl>
            </section>

            <section class="section p-3 p-lg-4">
                <h2 class="mb-3">Peserta (@Model.Participants.Count)</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th class="text-end">#</th>
                            <th>Nama</th>
                            <th>NIK</th>
                            <th>No. HP</th>
                            <th>Kontak darurat</th>
                        </tr>
                        </thead>
                        <tbody class="tabular-nums">
                        @for (var i = 0; i < Model.Participants.Count; i++)
                        {
                            var participant = Model.Participants[i];
                            <tr>
                                <td class="text-end">@(i + 1)</td>
                                <td>@participant.FullName</td>
                                <td>@participant.NIK</td>
                                <td class="text-nowrap">@participant.PhoneNumber</td>
                                <td>@participant.EmergencyContactName <span class="text-secondary text-nowrap">(@participant.EmergencyContactPhone)</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="section p-3 p-lg-4">
                <h2 class="mb-3">Pembayaran</h2>
                @if (!requiresPayment)
                {
                    <p class="mb-0">Booking ini gratis, gak perlu upload bukti transfer.</p>
                }
                else if (payment is null)
                {
                    <p class="mb-0">@(((PaymentStatus?)null).ToPaymentBadge(Model.TotalPrice)) <span class="ms-1 text-secondary">Belum ada bukti transfer.</span></p>
                }
                else
                {
                    <dl class="row mb-0 tabular-nums">
                        <dt class="col-sm-4 fw-normal text-secondary">Status</dt>
                        <dd class="col-sm-8">@(((PaymentStatus?)payment.Status).ToPaymentBadge(Model.TotalPrice))</dd>
                        <dt class="col-sm-4 fw-normal text-secondary">Jumlah</dt>
                        <dd class="col-sm-8">@payment.Amount.ToRupiah()</dd>
                        <dt class="col-sm-4 fw-normal text-secondary">Diupload</dt>
                        <dd class="col-sm-8">@payment.UploadedAt.ToDisplayDateTime()</dd>
                        @if (payment.VerifiedAt is { } verifiedAt)
                        {
                            <dt class="col-sm-4 fw-normal text-secondary">Diverifikasi</dt>
                            <dd class="col-sm-8">@verifiedAt.ToDisplayDateTime()</dd>
                        }
                        @if (payment.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(payment.RejectionReason))
                        {
                            <dt class="col-sm-4 fw-normal text-secondary">Alasan ditolak</dt>
                            <dd class="col-sm-8">@payment.RejectionReason</dd>
                        }
                        <dt class="col-sm-4 fw-normal text-secondary">Bukti transfer</dt>
                        <dd class="col-sm-8 mb-0">
                            <a asp-controller="Payment" asp-action="Proof" asp-route-bookingId="@Model.Id" target="_blank" rel="noopener">Lihat file</a>
                        </dd>
                    </dl>
                }
            </section>

            @if (Model.Review is { } review)
            {
                <section class="section p-3 p-lg-4">
                    <h2 class="mb-2">Ulasan</h2>
                    <p class="mb-1">
                        <span class="rating-star" role="img" aria-label="Rating @review.Rating dari 5">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                        <span class="text-secondary small ms-2">@review.CreatedAt.ToDisplayDate()</span>
                    </p>
                    @if (!string.IsNullOrEmpty(review.Comment))
                    {
                        <p class="mb-0">@review.Comment</p>
                    }
                </section>
            }
        </div>

        @if (isOwner && Model.Status == BookingStatus.Pending)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-4"
                  onsubmit="return confirm('Batalkan booking ini? Booking yang udah dibatalkan gak bisa diaktifkan lagi.');">
                <button type="submit" class="btn btn-outline-danger">Batalkan Booking</button>
            </form>
        }
    </div>

    @* ---------- Panel admin: kanan di desktop, atas di mobile ---------- *@
    @if (isAdmin)
    {
        <div class="col-lg-4 order-first order-lg-last">
            <aside class="card sticky-panel" aria-labelledby="admin-title">
                <div class="card-body p-3 p-lg-4">
                    <h2 id="admin-title" class="mb-3">Aksi Admin</h2>

                    <p class="small text-secondary mb-1">Dipesan oleh</p>
                    <p class="mb-3">
                        <span class="fw-semibold">@Model.UserFullName</span><br/>
                        <span class="text-secondary small text-break">@Model.UserEmail</span>
                    </p>

                    @if (payment?.Status == PaymentStatus.Pending)
                    {
                        <div class="border-top pt-3 mb-3">
                            <p class="fw-semibold mb-1">Pembayaran menunggu verifikasi</p>
                            <p class="small mb-2">
                                <span class="tabular-nums">@payment.Amount.ToRupiah()</span> &middot;
                                <a asp-controller="Payment" asp-action="Proof" asp-route-bookingId="@Model.Id" target="_blank" rel="noopener">Lihat bukti transfer</a>
                            </p>
                            <form asp-controller="Payment" asp-action="Verify" method="post" class="mb-2"
                                  onsubmit="return confirm('Verifikasi pembayaran ini? Booking otomatis jadi Disetujui.');">
                                <input type="hidden" name="BookingId" value="@Model.Id"/>
                                <input type="hidden" name="Status" value="@PaymentStatus.Verified"/>
                                <button type="submit" class="btn btn-success w-100">Verifikasi Pembayaran</button>
                            </form>
                            <form asp-controller="Payment" asp-action="Verify" method="post"
                                  onsubmit="return confirm('Tolak bukti pembayaran ini? Pendaki perlu upload ulang.');">
                                <input type="hidden" name="BookingId" value="@Model.Id"/>
                                <input type="hidden" name="Status" value="@PaymentStatus.Rejected"/>
                                <label for="payment-reject-reason" class="form-label small">Alasan ditolak <span class="text-secondary">(opsional)</span></label>
                                <input type="text" id="payment-reject-reason" name="RejectionReason" maxlength="500" class="form-control mb-2"/>
                                <button type="submit" class="btn btn-outline-danger w-100">Tolak Pembayaran</button>
                            </form>
                        </div>
                    }

                    @if (Model.AllowedNextStatuses.Any())
                    {
                        <div class="border-top pt-3 d-flex flex-column gap-2">
                            <p class="fw-semibold mb-0">Ubah status booking</p>
                            @foreach (var nextStatus in Model.AllowedNextStatuses)
                            {
                                var (label, buttonClass, confirmText) = nextStatus switch
                                {
                                    BookingStatus.Approved => ("Setujui Booking", "btn-success", "Setujui booking ini?"),
                                    BookingStatus.Completed => ("Tandai Selesai", "btn-success", "Tandai pendakian ini selesai? Pendaki bisa kasih ulasan setelahnya."),
                                    BookingStatus.Rejected => ("Tolak Booking", "btn-outline-danger", "Tolak booking ini? Status gak bisa dikembalikan."),
                                    _ => ("Batalkan Booking", "btn-outline-danger", "Batalkan booking ini? Status gak bisa dikembalikan.")
                                };
                                <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('@confirmText');">
                                    <input type="hidden" name="BookingId" value="@Model.Id"/>
                                    <input type="hidden" name="Status" value="@nextStatus"/>
                                    @if (nextStatus == BookingStatus.Rejected)
                                    {
                                        <label for="booking-reject-reason" class="form-label small">Alasan ditolak <span class="text-secondary">(opsional)</span></label>
                                        <input type="text" id="booking-reject-reason" name="RejectionReason" maxlength="500" class="form-control mb-2"/>
                                    }
                                    <button type="submit" class="btn @buttonClass w-100">@label</button>
                                </form>
                            }
                        </div>
                    }
                    else if (payment?.Status != PaymentStatus.Pending)
                    {
                        <p class="small text-secondary border-top pt-3 mb-0">Gak ada aksi lagi buat booking berstatus @Model.Status.ToLabel().</p>
                    }
                </div>
            </aside>
        </div>
    }
</div>

<p class="mt-4 mb-0">
    @if (isAdmin && !isOwner)
    {
        <a asp-action="Manage">&larr; Kembali ke Kelola Booking</a>
    }
    else
    {
        <a asp-action="MyBookings">&larr; Kembali ke Booking Saya</a>
    }
</p>
