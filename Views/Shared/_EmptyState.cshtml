@model Tebing.ViewModels.Shared.EmptyStateViewModel

<div class="card empty-state">
    <div>
        <span class="empty-state__icon"><partial name="_Icon" model='"mountain"'/></span>
    </div>
    <p class="fw-bold mb-1">@Model.Title</p>
    <p class="text-secondary mb-0">@Model.Message</p>
    @if (Model.ActionText is not null && Model.ActionUrl is not null)
    {
        <a href="@Model.ActionUrl" class="btn btn-outline-secondary mt-3">@Model.ActionText</a>
    }
</div>
