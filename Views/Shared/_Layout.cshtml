@using Tebing.Common.Regions
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Menu aktif: teks hijau + tebal (lihat docs/UI_UX.md §4.1).
    string NavClass(bool active) => active ? "nav-link active" : "nav-link";
    string? AriaCurrent(bool active) => active ? "page" : null;

    var isMountain = controller == "Mountain";
    var isMyBookings = controller == "Booking" && action != "Manage";
    var isManage = controller == "Booking" && action == "Manage";

    // Halaman dengan banner/header foto lebar penuh (Home, detail gunung) ngatur container-nya sendiri.
    var fullBleed = ViewData["FullBleed"] is true;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Tebing</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/lib/fonts/plus-jakarta-sans/PlusJakartaSans-latin.var.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header class="sticky-top">
    <nav class="navbar navbar-expand-md bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand d-inline-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <partial name="_Logo"/>
                Tebing
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                    aria-controls="main-nav" aria-expanded="false" aria-label="Buka menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="main-nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="@NavClass(isMountain)" aria-current="@AriaCurrent(isMountain)"
                           asp-area="" asp-controller="Mountain" asp-action="Index">Gunung</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="@NavClass(isMyBookings)" aria-current="@AriaCurrent(isMyBookings)"
                               asp-area="" asp-controller="Booking" asp-action="MyBookings">Booking Saya</a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="@NavClass(isManage)" aria-current="@AriaCurrent(isManage)"
                               asp-area="" asp-controller="Booking" asp-action="Manage">Kelola Booking</a>
                        </li>
                    }
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2 py-2 py-md-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-secondary me-1">Hi, @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Keluar</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link px-2" asp-controller="Account" asp-action="Login">Masuk</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Daftar</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

@if (fullBleed)
{
    <main role="main">
        <div class="container">
            <partial name="_FlashMessages"/>
        </div>
        @RenderBody()
    </main>
}
else
{
    @* padding bawah = ruang buat pembatas punggungan footer yang naik nutupin bagian bawah main. *@
    <main role="main" class="container pt-4 main-ridge-space">
        <partial name="_FlashMessages"/>
        @RenderBody()
    </main>
}

<footer class="site-footer bg-contour">
    <div class="site-footer__ridge">
        <partial name="_RidgeDivider" model="@(new RidgeDividerViewModel(RidgeVariant.A, Flip: true))"/>
    </div>
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-5">
                <p class="site-footer__brand d-inline-flex align-items-center gap-2 mb-2">
                    <partial name="_Logo"/>
                    Tebing
                </p>
                <p class="mb-0">Booking pendakian gunung se-Indonesia, tanpa antre di basecamp.</p>
            </div>
            <nav class="col-6 col-md-4" aria-labelledby="footer-explore">
                <p id="footer-explore" class="site-footer__heading">Jelajah</p>
                <ul class="list-unstyled mb-0">
                    @foreach (var island in Enum.GetValues<Island>())
                    {
                        <li><a asp-area="" asp-controller="Mountain" asp-action="Index" asp-route-island="@island">@island.ToLabel()</a></li>
                    }
                </ul>
            </nav>
            <nav class="col-6 col-md-3" aria-labelledby="footer-help">
                <p id="footer-help" class="site-footer__heading">Bantuan</p>
                <ul class="list-unstyled mb-0">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="cara-kerja">Cara booking</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Kebijakan Privasi</a></li>
                </ul>
            </nav>
        </div>
        <p class="site-footer__bottom small mb-0">
            &copy; 2026 Tebing &middot; Foto gunung: kontributor Wikimedia Commons (kredit lengkap di tiap halaman gunung)
        </p>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/carousel.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
