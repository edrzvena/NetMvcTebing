@model ErrorViewModel
@{
    ViewData["Title"] = "Terjadi Kesalahan";
}

<div class="form-narrow mx-auto mt-4">
    <partial name="_EmptyState" model="@(new EmptyStateViewModel("Terjadi kesalahan",
        "Ada yang error waktu memproses permintaan kamu. Coba lagi beberapa saat lagi.",
        "Kembali ke Beranda", Url.Action("Index", "Home")))"/>

    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary text-center mt-3 mb-0">Kode permintaan: <code>@Model.RequestId</code></p>
    }
</div>
