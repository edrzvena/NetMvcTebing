@model RidgeDividerViewModel
@* Pembatas section bentuk punggungan gunung berlapis (docs/UI_UX.md §4.15). Warnanya ikut `color` parent
   (fill="currentColor") — set ke warna section berikutnya. Parent butuh class .has-ridge (atau position relative). *@
@{
    // 3 lapis: belakang (pudar) → depan (solid). viewBox 1440x120, di-stretch selebar layar.
    string[] layers = Model.Variant == RidgeVariant.A ? LayersA : LayersB;
    string[] opacities = [".35", ".6", "1"];
}
<svg class="ridge @(Model.Flip ? "ridge--flip" : "")" viewBox="0 0 1440 120" preserveAspectRatio="none"
     aria-hidden="true" focusable="false">
    @for (var i = 0; i < layers.Length; i++)
    {
        <path fill="currentColor" opacity="@opacities[i]" d="@layers[i]"/>
    }
</svg>

