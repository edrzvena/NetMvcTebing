@model Tebing.DTOs.Mountain.MountainListDto

@* Kartu gunung v2 (docs/UI_UX.md §4.4): foto 4:3, badge di atas foto, seluruh kartu bisa diklik. *@
@{
    var isClosed = Model.Status == MountainStatus.Closed;
    // Kartu yang pasti kelihatan di layar pertama (diset dari view pemanggil) gak di-lazy-load.
    var eager = ViewData["EagerImage"] is true;
}

<article class="card mountain-card lift h-100 @(isClosed ? "mountain-card--closed" : "")">
    <div class="mountain-card__media">
        @if (Model.ImagePath is { } imagePath)
        {
            @* alt kosong: nama gunung udah ada di judul kartu, foto cuma pelengkap. File 640 (16:9) di-crop
               jadi 4:3 lewat object-fit, gak bikin file baru. *@
            <img src="@MountainImageProcessor.Url(imagePath, 640)" alt="" width="640" height="480"
                 loading="@(eager ? "eager" : "lazy")" decoding="async"/>
        }
        else
        {
            <div class="mountain-card__placeholder">
                <partial name="_Icon" model='"mountain"'/>
            </div>
        }
        <span class="mountain-card__badge mountain-card__badge--start badge">@Model.Difficulty.ToLabel()</span>
        @if (isClosed)
        {
            <span class="mountain-card__badge mountain-card__badge--end badge bg-danger-subtle text-danger-emphasis">
                @MountainStatus.Closed.ToLabel()
            </span>
        }
    </div>
    <div class="card-body d-flex flex-column gap-1 p-3">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="card-title mb-0">
                <a asp-controller="Mountain" asp-action="Detail" asp-route-id="@Model.Id"
                   class="stretched-link text-reset text-decoration-none">@Model.Name</a>
            </h3>
            @if (Model.AverageRating is { } rating)
            {
                <span class="mountain-card__rating text-nowrap tabular-nums">
                    <span class="rating-star"><partial name="_Icon" model='"star-fill"'/></span>
                    @rating.ToRating()
                    <span class="visually-hidden">dari @Model.ReviewCount ulasan</span>
                </span>
            }
        </div>
        <p class="mountain-card__meta mb-0 tabular-nums">
            <span class="text-nowrap"><partial name="_Icon" model='"pin"'/> @Model.Province</span>
            <span class="text-nowrap"><partial name="_Icon" model='"mountain"'/> @Model.HeightMeters.ToNumber() mdpl</span>
        </p>
        <p class="mountain-card__meta mb-0">
            @(Model.RouteCount > 0 ? $"{Model.RouteCount} jalur" : "Belum ada jalur")
            @if (Model.AverageRating is null)
            {
                <span>&middot; Belum ada ulasan</span>
            }
        </p>
        @if (Model.MinPricePerPerson is { } minPrice)
        {
            <p class="mb-0 mt-auto pt-2 tabular-nums">
                @if (minPrice <= 0)
                {
                    <span class="fw-bold">Gratis</span>
                }
                else
                {
                    <span class="mountain-card__meta">Mulai</span>
                    <span class="fw-bold">@minPrice.ToRupiah()</span><span class="mountain-card__meta"> /orang</span>
                }
            </p>
        }
    </div>
</article>
