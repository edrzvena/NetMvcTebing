@model Tebing.DTOs.Mountain.RouteCreateDto

@{
    ViewData["Title"] = "Tambah Jalur Pendakian";
}

<h1>Tambah Jalur Pendakian</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="AddRoute" method="post">
            <input type="hidden" asp-for="MountainId"/>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control"/>
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EstimatedDuration" class="form-label"></label>
                <input asp-for="EstimatedDuration" class="form-control" placeholder="misal: 2 hari 1 malam"/>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DailyQuota" class="form-label"></label>
                <input asp-for="DailyQuota" class="form-control" placeholder="Kosongkan kalau tanpa batas"/>
                <span asp-validation-for="DailyQuota" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a asp-action="Detail" asp-route-id="@Model.MountainId" class="btn btn-link">Batal</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
