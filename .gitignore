## .NET / Visual Studio standard .gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
*.userosscache
*.sln.docstates

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Rider
.idea/
*.sln.iml
riderModule.iml
/_ReSharper.Caches/

# VS Code
.vscode/

# NuGet packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
/packages/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish / deployment
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# Others
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# EF Core
*.edmx.diagram

# Local secrets / environment overrides (jangan pernah commit ini)
appsettings.*.local.json
*.env

# Upload file user (bukti transfer, dst) — jangan ikut ke-commit
App_Data/

# Foto gunung yang diupload admin (hasil resize, disajikan publik) — jangan ikut ke-commit.
# Foto contoh hasil seed ada di wwwroot/images/mountains/ dan ikut di-commit.
wwwroot/uploads/
